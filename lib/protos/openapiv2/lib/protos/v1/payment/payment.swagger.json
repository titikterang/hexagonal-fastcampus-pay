{
  "swagger": "2.0",
  "info": {
    "title": "Fast Campus Pay (Payment API Endpoint)",
    "version": "1.0",
    "contact": {
      "name": "Fast Campus Payment",
      "url": "https://github.com/titikterang",
      "email": "azwar.nrst@gmail.com"
    }
  },
  "tags": [
    {
      "name": "PaymentService"
    }
  ],
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "HealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/v1HealthResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "membership"
        ]
      }
    },
    "/v1/payment/precheck": {
      "get": {
        "summary": "Get Payment Precheck Status",
        "operationId": "GetPaymentPrecheckInfo",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/v1PaymentPrecheckResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountNo",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "payment"
        ]
      }
    },
    "/v1/payment/status": {
      "get": {
        "summary": "Get Payment Status",
        "operationId": "GetPaymentStatus",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/v1PaymentStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "invoiceId",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "payment"
        ]
      }
    },
    "/v1/payment/submit": {
      "post": {
        "summary": "Submit Payment",
        "operationId": "SubmitPayment",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/v1SubmitPaymentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SubmitPaymentPayload"
            }
          }
        ],
        "tags": [
          "money"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "typeMoney": {
      "type": "object",
      "properties": {
        "currencyCode": {
          "type": "string",
          "description": "The three-letter currency code defined in ISO 4217."
        },
        "units": {
          "type": "string",
          "format": "int64",
          "description": "The whole units of the amount.\nFor example if `currencyCode` is `\"USD\"`, then 1 unit is one US dollar."
        },
        "nanos": {
          "type": "integer",
          "format": "int32",
          "description": "Number of nano (10^-9) units of the amount.\nThe value must be between -999,999,999 and +999,999,999 inclusive.\nIf `units` is positive, `nanos` must be positive or zero.\nIf `units` is zero, `nanos` can be positive, zero, or negative.\nIf `units` is negative, `nanos` must be negative or zero.\nFor example $-1.75 is represented as `units`=-1 and `nanos`=-750,000,000."
        }
      },
      "description": "Represents an amount of money with its currency type."
    },
    "v1HealthResponse": {
      "type": "object",
      "properties": {
        "response": {
          "type": "string"
        }
      }
    },
    "v1PaymentInfo": {
      "type": "object",
      "properties": {
        "datetime": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1PaymentStatus"
        }
      }
    },
    "v1PaymentInfoResponse": {
      "type": "object",
      "properties": {
        "trxId": {
          "type": "string"
        },
        "accountNo": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/definitions/typeMoney"
        }
      }
    },
    "v1PaymentPrecheckResponse": {
      "type": "object",
      "properties": {
        "balance": {
          "type": "string",
          "format": "int64"
        },
        "info": {
          "$ref": "#/definitions/v1UserInfoResponse"
        }
      }
    },
    "v1PaymentStatus": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "UNPAID",
        "PENDING",
        "FAILED",
        "PAID"
      ],
      "default": "UNSPECIFIED"
    },
    "v1PaymentStatusResponse": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1PaymentStatus"
        },
        "amount": {
          "type": "string",
          "format": "int64"
        },
        "datetime": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "paymentHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1PaymentInfo"
          }
        }
      }
    },
    "v1SubmitPaymentPayload": {
      "type": "object",
      "properties": {
        "merchantId": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "format": "int64"
        },
        "accountNo": {
          "type": "string"
        }
      }
    },
    "v1SubmitPaymentResponse": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1PaymentStatus"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "v1UserInfoResponse": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "fullname": {
          "type": "string"
        },
        "accountNumber": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}
